<?xml version="1.0" encoding="utf-8"?>
<!--
  CR-29：系统备份全排除（≤API 30 的 fullBackupContent）。
  应用数据（使用记录数据库、DataStore 设置、合并账本）不进入系统云备份 / adb backup；
  导出与换机只经 §5.10 的 JSON/CSV 导出与云同步。allowBackup 已为 false，本文件是兜底。
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
