<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      系统栏透明化在这里做兜底：真正的 edge-to-edge 由 MainActivity 的
      enableEdgeToEdge() 打开（它同时负责图标明暗）。缺了 API 调用时，
      这几条属性让窗口至少不是不透明黑条。

      windowLayoutInDisplayCutoutMode=shortEdges：刘海/挖孔屏下允许内容画进挖孔区，
      配合 AppNav 的 statusBarsPadding 才不会在竖屏顶部留一条黑带。
    -->
    <style name="Theme.ScreenTrace" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
