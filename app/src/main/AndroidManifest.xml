<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- §2.1 降级通道：使用情况访问（signature|privileged，需引导用户在设置里授权） -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- §2.1 主通道：向 Shizuku 申请授权（S05：只加依赖不注册 provider 会在运行期失败） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- §5.10 / §6：仅云同步（WebDAV / Google Drive）使用。核心功能全离线，
         骨架阶段不发起任何网络请求。接入 §5.10 时仍需遵守「仅手动或按频率自动触发」。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- §3-8 展示名回填：Android 11+ 包可见性限制下，不声明就查不到别的应用的
         ApplicationInfo（getApplicationInfo 直接抛 NameNotFoundException），
         展示名只能退回包名。这里只声明「有桌面入口的应用」这一类——
         屏幕使用时间统计的本来也都是这类；不用 QUERY_ALL_PACKAGES，
         避免申请一个过宽的权限。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ScreenTraceApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenTrace">
        <!-- S05（Kimi 评审）：Shizuku provider 必须注册，否则 Shizuku 授权回调与权限查询直接失败 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ScreenTrace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
